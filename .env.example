# Copy to .env and adjust. Compose works without it (dev defaults below),
# but committed code must never contain real secrets -- override in .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supply_chain
AIRFLOW_DB=airflow_db
DB_HOST=postgres
DB_PORT=5432
DB_NAME=supply_chain
DB_USER=postgres
DB_PASSWORD=postgres
DBT_HOST=postgres
DBT_PORT=5432
DBT_DATABASE=supply_chain
DBT_SCHEMA=silver
DBT_USER=postgres
DBT_PASSWORD=postgres
AIRFLOW_PORT=8080
HOST_POSTGRES_PORT=5432
SUPPLY_CHAIN_PIPELINE_NAME=supply_chain_ingestion_pipeline
SUPPLY_CHAIN_MAX_REJECT_RATE=5.0

